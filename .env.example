# 复制成 .env 再改：  cp .env.example .env
# .env 已经在 .gitignore 里，不会进仓库。
# 密码用 `openssl rand -hex 16` 生成，不要用 123456。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_openssl_rand_hex_16
MYSQL_DATABASE=fur_guardian
MYSQL_USER=fur
MYSQL_PASSWORD=CHANGE_ME_app_openssl_rand_hex_16

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_redis_openssl_rand_hex_16

# ---- 端口绑定 ----
# 127.0.0.1 = 只允许本机 / SSH 隧道访问（最安全，推荐）
# 0.0.0.0   = 对外开放，必须同时在阿里云安全组里只放行队友的 IP
BIND_ADDR=127.0.0.1
MYSQL_PORT=3306
REDIS_PORT=6379
