<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.purr</groupId>
    <artifactId>fur-guardian</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>fur-guardian</name>
    <description>FurGuardian - Smart Pet Care Assistant</description>

    <modules>
        <module>pet-common</module>
        <module>pet-nutrition-core</module>
        <module>pet-knowledge</module>
        <module>pet-ai</module>
        <module>pet-biz</module>
        <module>pet-job</module>
        <module>pet-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <langchain4j.version>1.22.0</langchain4j.version>
        <langchain4j.community.version>1.22.0-beta32</langchain4j.community.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <springdoc.version>3.1.1</springdoc.version>
        <aliyun-oss.version>3.18.1</aliyun-oss.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- LangChain4j core BOM -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- LangChain4j community BOM (must follow core BOM) -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-community-bom</artifactId>
                <version>${langchain4j.community.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Project modules -->
            <dependency>
                <groupId>com.purr</groupId>
                <artifactId>pet-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.purr</groupId>
                <artifactId>pet-nutrition-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.purr</groupId>
                <artifactId>pet-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.purr</groupId>
                <artifactId>pet-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.purr</groupId>
                <artifactId>pet-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.purr</groupId>
                <artifactId>pet-job</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Third-party versions managed by project -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
