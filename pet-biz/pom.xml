<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.purr</groupId>
        <artifactId>fur-guardian</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>pet-biz</artifactId>
    <name>pet-biz</name>
    <description>Business services (pet profile, reminders, weekly reports)</description>

    <dependencies>
        <dependency>
            <groupId>com.purr</groupId>
            <artifactId>pet-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.purr</groupId>
            <artifactId>pet-nutrition-core</artifactId>
        </dependency>
        <!-- MyBatis-Plus Boot 4 starter (boot3 starter will silently fail) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- JSqlParser extracted from core since 3.5.9, version must match starter -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- MySQL driver, version managed by Boot BOM -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

</project>
